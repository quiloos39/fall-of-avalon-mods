<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>HttpProbe</AssemblyName>
    <RootNamespace>HttpProbe</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <DebugType>portable</DebugType>
    <Version>1.0.0</Version>
    <NoWarn>CS0436;CS1701;CS1702;CS0618</NoWarn>

    <GameRoot>C:\Program Files (x86)\Steam\steamapps\common\Tainted Grail FoA</GameRoot>
    <GameManaged>$(GameRoot)\Fall of Avalon_Data\Managed</GameManaged>
    <GameBepInExCore>$(GameRoot)\BepInEx\core</GameBepInExCore>
    <PluginsTarget>$(GameRoot)\BepInEx\plugins</PluginsTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Publicizer" Version="2.2.1" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Publicize Include="TG.Main" />
  </ItemGroup>

  <ItemGroup>
    <!-- Game core (publicized so endpoint authors can poke at game state from a hot-loaded DLL) -->
    <Reference Include="TG.Main">
      <HintPath>$(GameManaged)\TG.Main.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Awaken.Utility">
      <HintPath>$(GameManaged)\Awaken.Utility.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- JSON -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GameManaged)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- HttpListener lives in System.dll on .NET Framework / Mono. The game ships with this. -->
    <Reference Include="System">
      <HintPath>$(GameManaged)\System.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Unity -->
    <Reference Include="UnityEngine">
      <HintPath>$(GameManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- BepInEx -->
    <Reference Include="BepInEx">
      <HintPath>$(GameBepInExCore)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameBepInExCore)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CopyToPlugins" AfterTargets="Build" Condition="Exists('$(PluginsTarget)')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginsTarget)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Copied $(TargetFileName) to $(PluginsTarget)" />
  </Target>

</Project>
